# Maintainer: Jens Reidel <adrian@travitia.xyz>

_flavor="postmarketos-qcom-sm8450"
pkgname=linux-$_flavor
pkgver=7.2.8
pkgrel=159
pkgdesc="Mainline Kernel fork for SM8450 devices"
arch="aarch64"
_carch="arm64"
url="https://github.com/kreatoo/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
	"
makedepends="bison findutils flex installkernel kmod openssl-dev perl python3 dtc"

_config="config-$_flavor.$arch"

# Source
_repo="linux"
_commit="87b45a4e2d5d3c908284b43513fa217872646ed9"
_initramfs="initramfs.cpio.gz"

source="$_repo-$_commit.tar.gz::https://github.com/kreatoo/$_repo/archive/$_commit/$_repo-$_commit.tar.gz $_config $_initramfs"
builddir="$srcdir/$_repo-$_commit"

prepare() {
	default_prepare
	cp "$startdir/$_config" "$builddir/.config"
	cp "$startdir/$_initramfs" "$builddir/"
	test -s "$builddir/$_initramfs"
	# Build the relacheck host tool needed for arm64 PI code
	gcc -o arch/arm64/kernel/pi/relacheck \
		arch/arm64/kernel/pi/relacheck.c
}

build() {
	unset LDFLAGS
	_make() {
		make ARCH="$_carch" CC="${CC:-gcc}" HOSTCC="gcc" \
			KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor" "$@"
	}
	# Resolve the config twice: olddefconfig can drop a symbol whose
	# dependency only turns on in the same pass (seen with
	# CONFIG_SND_SOC_AW88261 and CONFIG_VIDEO_IMX355).
	_make olddefconfig
	_make olddefconfig
	# ABL requires the uncompressed Image (it does not support Image.gz)
	_make -j$(nproc) dtbs
	_make -j$(nproc) Image modules
}

package() {
	_dtb="$builddir/arch/arm64/boot/dts/qcom/sm8475-xiaomi-mondrian.dtb"
	mkdir -p "$pkgdir"/boot
	make install modules_install \
		ARCH="$_carch" \
		CC="${CC:-gcc}" HOSTCC="gcc" \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1
	install -D "$_dtb" \
		"$pkgdir"/boot/dtbs/qcom/sm8475-xiaomi-mondrian.dtb
	install -Dm644 "$builddir"/arch/arm64/boot/Image \
		"$pkgdir"/boot/vmlinuz
	_kernelrelease="$(make -s ARCH="$_carch" kernelrelease)"
	depmod -b "$pkgdir"/usr "$_kernelrelease"
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

