// Allow the phone user to control NetworkManager without a root prompt.
// Mondrian has one interactive user in plugdev; elogind may not mark the
// Plasma D-Bus subject as active, so do not require subject.active.
polkit.addRule(function(action, subject) {
    if (!subject.isInGroup("plugdev"))
        return polkit.Result.NOT_HANDLED;

    if (action.id == "org.freedesktop.NetworkManager.network-control" ||
        action.id == "org.freedesktop.NetworkManager.wifi.scan" ||
        action.id == "org.freedesktop.NetworkManager.enable-disable-wifi" ||
        action.id == "org.freedesktop.NetworkManager.settings.modify.system" ||
        action.id == "org.freedesktop.NetworkManager.settings.modify.own")
        return polkit.Result.YES;

    return polkit.Result.NOT_HANDLED;
});
