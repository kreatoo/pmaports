#!/usr/bin/python3

import argparse
import struct
from pathlib import Path

PAGE_SIZE = 4096
HEADER_SIZE = 1584


def main():
    parser = argparse.ArgumentParser(description="Generate Mondrian's kernel-only boot image")
    parser.add_argument("kernel", type=Path)
    parser.add_argument("boot_output", type=Path)
    args = parser.parse_args()

    kernel = args.kernel.read_bytes()
    # Match the booted v4 layout in the root mkboot.py: no ramdisk or
    # signature, and an empty boot cmdline (vendor_boot carries the cmdline).
    header = bytearray(PAGE_SIZE)
    header[:8] = b"ANDROID!"
    struct.pack_into("<I", header, 8, len(kernel))
    struct.pack_into("<I", header, 20, HEADER_SIZE)
    struct.pack_into("<I", header, 40, 4)

    with args.boot_output.open("wb") as output:
        output.write(header)
        output.write(kernel)
        output.write(bytes(-len(kernel) % PAGE_SIZE))


if __name__ == "__main__":
    main()
