# Maintainer: Jens Reidel <adrian@travitia.xyz>
# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-xiaomi-mondrian
pkgdesc="Xiaomi POCO F5 Pro / Redmi K60"
pkgver=1
pkgrel=36
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf
	boot-deploy>=0.25.0-r2
	linux-postmarketos-qcom-sm8450
	firmware-xiaomi-mondrian-gpu
	firmware-xiaomi-mondrian-dsp
	firmware-xiaomi-mondrian-audio
	firmware-xiaomi-mondrian-tplg=1-r20
	mesa-dri-gallium
	python3
	linux-firmware-qcom
	android-tools
	msm-firmware-loader
	rmtfs
	qmi-utils
	soc-qcom-modem-systemd
	tqftpserv
	postmarketos-base
	qbootctl
	qbootctl-openrc
	busybox-extras
	feedbackd
	pipewire-pulse
	pipewire-spa-bluez
	hexagonrpcd
"
makedepends="
	devicepkg-dev
"
install="$pkgname.post-install $pkgname.post-upgrade"
source="
	alsa-ucm-conf/HiFi.conf
	alsa-ucm-conf/mondrian.conf
	deviceinfo
	50-mondrian-bluetooth-firmware.conf
	pulseaudio-hidden.desktop
	99-mondrian-audio.conf
	50-mondrian-plasma-user.conf
	pmos-usb-telnet.service
	mondrian-modem-firmware.service
	hexagonrpcd-sdsp-mondrian.conf
	iio-sensor-proxy-mondrian.conf
	mondrian-generate-bootimg
	mondrian-patch-vendor-boot
	vendor_boot.stock.img.gz
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm644 "$srcdir"/mondrian.conf \
		"$pkgdir/usr/share/alsa/ucm2/Xiaomi/mondrian/mondrian.conf"
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir/usr/share/alsa/ucm2/Xiaomi/mondrian/HiFi.conf"

	mkdir -p "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8450"
	ln -s ../../Xiaomi/mondrian/mondrian.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8450/Xiaomi-Mondrian.conf"

	install -Dm644 "$srcdir/pmos-usb-telnet.service" "$pkgdir/usr/lib/systemd/system/pmos-usb-telnet.service"
	install -Dm644 "$srcdir/mondrian-modem-firmware.service" \
		"$pkgdir/usr/lib/systemd/system/mondrian-modem-firmware.service"
	install -Dm644 "$srcdir/hexagonrpcd-sdsp-mondrian.conf" \
		"$pkgdir/usr/lib/systemd/system/hexagonrpcd-sdsp.service.d/50-mondrian.conf"
	install -Dm644 "$srcdir/iio-sensor-proxy-mondrian.conf" \
		"$pkgdir/usr/lib/systemd/system/iio-sensor-proxy.service.d/50-mondrian.conf"
	install -Dm644 "$srcdir/50-mondrian-bluetooth-firmware.conf" \
		"$pkgdir/etc/systemd/system/bluetooth.service.d/50-mondrian-bluetooth-firmware.conf"
	install -Dm644 "$srcdir"/50-mondrian-plasma-user.conf \
		"$pkgdir/etc/systemd/system/plasma-mobile.service.d/50-mondrian-plasma-user.conf"
	install -Dm644 "$srcdir"/99-mondrian-audio.conf \
		"$pkgdir/etc/skel/.config/wireplumber/wireplumber.conf.d/99-mondrian-audio.conf"
	mkdir -p "$pkgdir/etc/systemd/system/multi-user.target.wants"
	ln -s /usr/lib/systemd/system/pmos-usb-telnet.service "$pkgdir/etc/systemd/system/multi-user.target.wants/pmos-usb-telnet.service"
	ln -s /usr/lib/systemd/system/mondrian-modem-firmware.service \
		"$pkgdir/etc/systemd/system/multi-user.target.wants/mondrian-modem-firmware.service"

	install -Dm755 "$srcdir"/mondrian-generate-bootimg \
		"$pkgdir/usr/bin/mondrian-generate-bootimg"
	install -Dm755 "$srcdir"/mondrian-patch-vendor-boot \
		"$pkgdir/usr/bin/mondrian-patch-vendor-boot"
	install -Dm644 "$srcdir"/vendor_boot.stock.img.gz \
		"$pkgdir/usr/share/device-xiaomi-mondrian/vendor_boot.stock.img.gz"
}

