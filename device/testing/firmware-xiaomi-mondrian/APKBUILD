pkgname=firmware-xiaomi-mondrian
pkgver=1
pkgrel=20
pkgdesc="Firmware for Xiaomi POCO F5 Pro / Redmi K60"
subpackages="
	$pkgname-gpu
	$pkgname-audio
	$pkgname-dsp:dsp
	$pkgname-initramfs:initramfs
	$pkgname-tplg
	"
url="https://postmarketos.org"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps"
makedepends="alsa-utils m4 mtools unzip"
_audioreach_commit=d7a5e9d80ad18a7a6844eeb32cacbdeea0e7e677
_audioreach_dir="audioreach-topology-$_audioreach_commit"
source="
	a730_zap.mbn.zst
	aw882xx_acf.bin
	30-initramfs-firmware.files
	mondrian-firmware.zip::https://github.com/XiaomiFirmwareUpdaterReleases/firmware_xiaomi_mondrian/releases/download/stable-24.03.2026/fw_mondrian_mondrian_global-ota_full-OS3.0.5.0.VMNMIXM-user-15.0-15a5ad376e.zip
	Xiaomi-Mondrian.m4
	subgraph-device-tdm-playback.m4
	module_tdm.m4
	audioreach-audio-if-tokens.m4
	$_audioreach_dir.tar.gz::https://github.com/linux-msm/audioreach-topology/archive/$_audioreach_commit.tar.gz
"

build() {
	m4 -I "$srcdir" -I "$srcdir/$_audioreach_dir" "$srcdir/Xiaomi-Mondrian.m4" \
		> "$srcdir/Xiaomi-Mondrian-tplg.conf"
	alsatplg -c "$srcdir/Xiaomi-Mondrian-tplg.conf" \
		-o "$srcdir/Xiaomi-Mondrian-tplg.bin"
}

prepare() {
	unzip -p "$srcdir/mondrian-firmware.zip" firmware-update/modem.img \
		> "$srcdir/modem.img"
	mkdir -p "$srcdir/mondrian-adsp"
	mcopy -i "$srcdir/modem.img" "::image/adsp.*" "$srcdir/mondrian-adsp/"
	mcopy -i "$srcdir/modem.img" "::image/adspr.jsn" \
		"::image/adspua.jsn" "$srcdir/mondrian-adsp/"
}

package() {
	mkdir -p "$pkgdir"
}

gpu() {
	pkgdesc="Xiaomi POCO F5 Pro / Redmi K60 A730 GPU firmware"

	install -Dm644 "$srcdir"/a730_zap.mbn.zst \
		"$subpkgdir/lib/firmware/qcom/sm8450/mondrian/a730_zap.mbn.zst"
	install -Dm644 "$srcdir"/a730_zap.mbn.zst \
		"$subpkgdir/lib/firmware/qcom/sm8475/xiaomi/mondrian/a730_zap.mbn.zst"
}

audio() {
	pkgdesc="Xiaomi POCO F5 Pro / Redmi K60 AW88261 speaker firmware"

	install -Dm644 "$srcdir"/aw882xx_acf.bin \
		"$subpkgdir"/lib/firmware/aw882xx_acf.bin
}

dsp() {
	pkgdesc="Xiaomi POCO F5 Pro / Redmi K60 ADSP firmware"

	install -Dm644 "$srcdir"/mondrian-adsp/adsp.mdt \
		"$subpkgdir/lib/firmware/qcom/sm8475/xiaomi/mondrian/adsp.mdt"
	install -Dm644 "$srcdir"/mondrian-adsp/adspr.jsn \
		"$subpkgdir/lib/firmware/qcom/sm8475/xiaomi/mondrian/adspr.jsn"
	install -Dm644 "$srcdir"/mondrian-adsp/adspua.jsn \
		"$subpkgdir/lib/firmware/qcom/sm8475/xiaomi/mondrian/adspua.jsn"
	for segment in "$srcdir"/mondrian-adsp/adsp.b??; do
		install -Dm644 "$segment" \
			"$subpkgdir/lib/firmware/qcom/sm8475/xiaomi/mondrian/${segment##*/}"
	done
}

initramfs() {
	pkgdesc="Xiaomi POCO F5 Pro / Redmi K60 firmware for the initramfs"

	install -Dm644 "$srcdir/30-initramfs-firmware.files" -t \
		"$subpkgdir/usr/share/mkinitfs/files"
}

tplg() {
	pkgdesc="Xiaomi POCO F5 Pro / Redmi K60 AudioReach topology firmware"

	install -Dm644 "$srcdir/Xiaomi-Mondrian-tplg.bin" \
		"$subpkgdir/lib/firmware/qcom/sm8450/Xiaomi-Mondrian-tplg.bin"
}

