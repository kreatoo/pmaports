+				log "ERROR: vendor_boot patcher missing or not executable: ${deviceinfo_vendor_boot_patch}"
+				exit 1
+			}
+			log_arrow "initramfs: using vendor_boot template ${deviceinfo_vendor_boot_template}"
+			"${deviceinfo_vendor_boot_patch}" \
+				"${deviceinfo_vendor_boot_template}" \
+				"$_vendor_bootimg.template" \
+				"$(get_cmdline)" || exit 1
+			mv -f "$_vendor_bootimg.template" "$_vendor_bootimg" || exit 1
+		fi
 
 		additional_files="$additional_files $(basename $_vendor_bootimg)"
 	else
